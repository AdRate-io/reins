{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": [],
    "emitDeclarationOnly": true,
    "paths": {
      "@reins/core": ["./packages/core/src/index.ts"],
      "@reins/core/testing": ["./packages/core/src/testing/index.ts"],
      "@reins/brain": ["./packages/brain/src/index.ts"],
      "@reins/brain/node": ["./packages/brain/src/node.ts"],
      "@reins/eval": ["./packages/eval/src/index.ts"],
      "@reins/lowering-pi": ["./packages/lowering-pi/src/index.ts"],
      "@reins/server": ["./packages/server/src/index.ts"],
      "@reins/server/node": ["./packages/server/src/node.ts"],
      "@reins/store-sqlite": ["./packages/store-sqlite/src/index.ts"],
      "@reins/store-sqlite/node": ["./packages/store-sqlite/src/node.ts"],
      "@reins/store-pg": ["./packages/store-pg/src/index.ts"],
      "@reins/adapter-tanstack-ai": ["./packages/adapter-tanstack-ai/src/index.ts"],
      "reins": ["./packages/reins/src/index.ts"],
      "@reins/tools-mcp": ["./packages/tools-mcp/src/index.ts"],
      "@reins/tools-mcp/node": ["./packages/tools-mcp/src/node.ts"],
      "@reins/ui-agui": ["./packages/ui-agui/src/index.ts"]
    }
  }
}
