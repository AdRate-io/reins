{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": [],
    "emitDeclarationOnly": true,
    "paths": {
      "@reinsjs/core": ["./packages/core/src/index.ts"],
      "@reinsjs/core/testing": ["./packages/core/src/testing/index.ts"],
      "@reinsjs/brain": ["./packages/brain/src/index.ts"],
      "@reinsjs/brain/node": ["./packages/brain/src/node.ts"],
      "@reinsjs/eval": ["./packages/eval/src/index.ts"],
      "@reinsjs/lowering-pi": ["./packages/lowering-pi/src/index.ts"],
      "@reinsjs/server": ["./packages/server/src/index.ts"],
      "@reinsjs/server/node": ["./packages/server/src/node.ts"],
      "@reinsjs/store-sqlite": ["./packages/store-sqlite/src/index.ts"],
      "@reinsjs/store-sqlite/node": ["./packages/store-sqlite/src/node.ts"],
      "@reinsjs/store-pg": ["./packages/store-pg/src/index.ts"],
      "@reinsjs/adapter-tanstack-ai": ["./packages/adapter-tanstack-ai/src/index.ts"],
      "@reinsjs/agent": ["./packages/agent/src/index.ts"],
      "@reinsjs/tools-mcp": ["./packages/tools-mcp/src/index.ts"],
      "@reinsjs/tools-mcp/node": ["./packages/tools-mcp/src/node.ts"],
      "@reinsjs/ui-agui": ["./packages/ui-agui/src/index.ts"]
    }
  }
}
