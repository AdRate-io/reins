{
  "name": "@reinsjs/store-pg",
  "version": "0.3.7",
  "description": "reins — PostgreSQL-backed EventLog / BlobStore / MemoryStore / RunLease. Works with pg, PGlite and postgres.js (via postgresJsClient), or any client exposing query(text, params) → { rows }",
  "keywords": [
    "agent",
    "event-log",
    "postgres",
    "postgresql",
    "pglite",
    "postgres.js"
  ],
  "license": "MIT",
  "author": "NewRate Limited (https://www.adrate.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdRate-io/reins.git",
    "directory": "packages/store-pg"
  },
  "homepage": "https://github.com/AdRate-io/reins/tree/main/packages/store-pg#readme",
  "bugs": "https://github.com/AdRate-io/reins/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@reinsjs/core": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@reinsjs/server": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.0",
    "pg": "^8.23.0",
    "postgres": "3.4.9",
    "postgres-v4": "npm:postgres@4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
