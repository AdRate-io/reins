{
  "name": "@reins/store-sqlite",
  "version": "0.1.0",
  "description": "reins — SQLite-backed EventLog / BlobStore / MemoryStore. One SQL layer, driver supplied by the runtime (node:sqlite, bun:sqlite)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@reins/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
