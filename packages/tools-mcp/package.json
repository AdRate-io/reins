{
  "name": "@reins/tools-mcp",
  "version": "0.1.0",
  "description": "reins — MCP servers as a Socket: tools/list once per run, tools/call as Tool.execute, annotations → risk / approval defaults. Streamable HTTP on the Web-standard entry, stdio under ./node",
  "keywords": [
    "agent",
    "mcp",
    "model-context-protocol",
    "tools",
    "streamable-http",
    "stdio"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@reins/core": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@reins/brain": "workspace:*",
    "@types/node": "^22.0.0",
    "zod": "^4.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
