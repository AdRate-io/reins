{
  "name": "@reinsjs/tools-mcp",
  "version": "0.1.1",
  "description": "reins — MCP servers as a Socket: tools/list once per run, tools/call as Tool.execute, annotations → risk / approval defaults. Streamable HTTP on the Web-standard entry, stdio under ./node",
  "keywords": [
    "agent",
    "mcp",
    "model-context-protocol",
    "tools",
    "streamable-http",
    "stdio"
  ],
  "license": "MIT",
  "author": "NewRate Limited (https://www.adrate.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdRate-io/reins.git",
    "directory": "packages/tools-mcp"
  },
  "homepage": "https://github.com/AdRate-io/reins/tree/main/packages/tools-mcp#readme",
  "bugs": "https://github.com/AdRate-io/reins/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@reinsjs/core": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@reinsjs/brain": "workspace:*",
    "@types/node": "^22.0.0",
    "zod": "^4.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
