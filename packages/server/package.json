{
  "name": "@reinsjs/server",
  "version": "0.1.0",
  "description": "reins — Web-standard (Request) => Response handler: runs the loop, streams the timeline as SSE, replays from lastSeq on reconnect",
  "keywords": [
    "agent",
    "llm",
    "sse",
    "web-standard",
    "fetch-handler",
    "cloudflare-workers"
  ],
  "license": "MIT",
  "author": "NewRate Limited (https://www.adrate.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdRate-io/reins.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/AdRate-io/reins/tree/main/packages/server#readme",
  "bugs": "https://github.com/AdRate-io/reins/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@reinsjs/core": "workspace:*"
  },
  "devDependencies": {
